# Backend Environment Configuration Example
# Copy this file to .env and fill in your actual values

# ===============================================
# DATABASE CONFIGURATION (SUPABASE PostgreSQL)
# ===============================================
DB_URL=jdbc:postgresql://localhost:5432/chatbot_db
DB_USERNAME=postgres
DB_PASSWORD=your_database_password

# ===============================================
# GOOGLE OAUTH2 CONFIGURATION
# ===============================================
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ===============================================
# JWT CONFIGURATION
# ===============================================
# Use a strong secret key (minimum 32 characters recommended)
JWT_SECRET=your_very_long_secret_key_here_minimum_32_characters_recommended

# ===============================================
# MULTI-AGENT API CONFIGURATION (Google ADK)
# ===============================================
# URL của Multi-Agent FastAPI server (mặc định chạy trên port 8000)
MULTIAGENT_API_URL=http://127.0.0.1:8000

# ===============================================
# EMAIL CONFIGURATION
# ===============================================
# Gmail SMTP Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
# Use Gmail App Password (not your regular password)
# See: https://support.google.com/accounts/answer/185833
MAIL_PASSWORD=your_gmail_app_password

# Or for other email providers:
# MAIL_HOST=smtp.company.com
# MAIL_PORT=587
# MAIL_USERNAME=your_email@company.com
# MAIL_PASSWORD=your_email_password

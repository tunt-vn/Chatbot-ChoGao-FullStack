# ===============================================
# CẤU HÌNH KẾT NỐI DATABASE SUPABASE (POSTGRESQL)
#
# ===============================================
# Thay bằng chuỗi kết nối JDBC đến database PostgreSQL của bạn
DB_URL=...
# Thay bằng tên đăng nhập database
DB_USERNAME=...
# Thay bằng mật khẩu database
DB_PASSWORD=...

# ==================================
# CẤU HÌNH GOOGLE OAUTH2
#
# ==================================
# Thay bằng Client ID bạn nhận được từ Google Cloud Console
GOOGLE_CLIENT_ID=...
# Thay bằng Client Secret bạn nhận được từ Google Cloud Console
GOOGLE_CLIENT_SECRET=...

# ==================================
# CẤU HÌNH JWT
#
# ==================================
# Thay bằng một chuỗi bí mật ngẫu nhiên, dài và phức tạp do bạn tự nghĩ ra
JWT_SECRET=...

# ==================================
# N8N CONFIG
#
# ==================================
# Thay bằng URL webhook của N8N (nếu bạn dùng)
N8N_WEBHOOK_URL=...

# ==================================
# CẤU HÌNH GỬI EMAIL (SMTP)
#
# ==================================
# Thay bằng máy chủ SMTP (ví dụ: smtp.gmail.com)
MAIL_HOST=...
# Thay bằng cổng SMTP (ví dụ: 587 cho TLS)
MAIL_PORT=...
# Thay bằng email dùng để gửi
MAIL_USERNAME=...
# Thay bằng mật khẩu email (hoặc mật khẩu ứng dụng nếu dùng Gmail)
MAIL_PASSWORD=...